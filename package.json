{
  "name": "pdcaw",
  "version": "1.0.0",
  "description": "PDCA-workspace 서버용 CLI. 문서 동기화·릴리즈·백로그를 Claude Code 스킬이 MCP 없이 다루는 유일한 통로. 본문은 파일 그대로 전송되어 LLM 컨텍스트를 통과하지 않는다.",
  "type": "module",
  "bin": {
    "pdcaw": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
